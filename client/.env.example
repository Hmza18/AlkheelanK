# URL of the AlkheelanK Socket.io server.
# Local dev:
VITE_SERVER_URL=http://localhost:3001
# Production (Render): set this in Vercel project env vars, e.g.
# VITE_SERVER_URL=https://alkheelank-server.onrender.com

# Supabase (host accounts + saved quizzes). Find these in your Supabase project:
# Project Settings → API. The anon key is a public client key — safe to ship,
# protected by Row Level Security. NEVER put the service_role key here.
# Leave these blank to run in guest-only mode (no login, quizzes not saved).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
