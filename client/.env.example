# URL of the AlkheelanK Socket.io server.
# Local dev:
VITE_SERVER_URL=http://localhost:3001
# Production (Render): set this in Vercel project env vars, e.g.
# VITE_SERVER_URL=https://alkheelank-server.onrender.com

# Supabase (host accounts + saved quizzes). Dashboard → Settings → API Keys:
#   Project URL  → VITE_SUPABASE_URL
#   Publishable key (sb_publishable_...) → VITE_SUPABASE_ANON_KEY
# Legacy anon JWT (eyJ...) also works. NEVER put sb_secret_ or service_role here.
# Leave blank for guest-only mode. After editing, restart: npm run dev
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
