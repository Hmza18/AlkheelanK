# URL of the Alkheeloot Socket.io server (production only).
# Local dev: leave unset — Vite proxies /socket.io and /health to localhost:3001.
# You still must run the game server: npm run dev:server
# Production (Render): set this in Vercel project env vars, e.g.
# VITE_SERVER_URL=https://alkheelank-server.onrender.com
# VITE_SERVER_URL=
# Supabase (host accounts + saved quizzes). Dashboard → Settings → API Keys:
#   Project URL  → VITE_SUPABASE_URL
#   Publishable key (sb_publishable_...) → VITE_SUPABASE_ANON_KEY
# Legacy anon JWT (eyJ...) also works. NEVER put sb_secret_ or service_role here.
# Leave blank for guest-only mode. After editing, restart: npm run dev
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional production site root (Google OAuth redirect). On Vercel set to your live URL.
# VITE_SITE_URL=https://your-app.vercel.app

# Host lobby join text + QR base (defaults to alkheelan.xyz). QR uses VITE_SITE_URL when set.
# VITE_JOIN_HOST=alkheelan.xyz

# Set to true when Lemon Squeezy is verified — restores trial checkout CTAs
# VITE_BILLING_ENABLED=true
