# Port the server listens on (Render sets this automatically)
PORT=3001

# Allowed client origin(s) for CORS. Comma-separate multiple origins.
# Production example:
# CORS_ORIGIN=https://www.alkheelan.xyz,https://alkheelan.xyz
CORS_ORIGIN=*

# Optional — only for npm run apply-schema (scripts/apply-schema.mjs):
# SUPABASE_DB_PASSWORD=your-database-password
# Optional if auto-detect fails (from Dashboard → Database → Connection string):
# SUPABASE_POOLER_HOST=aws-1-ap-northeast-1.pooler.supabase.com
# SUPABASE_POOLER_PORT=6543
# Optional — only for node scripts/configure-auth.mjs:
# SUPABASE_ACCESS_TOKEN=sbp_...
