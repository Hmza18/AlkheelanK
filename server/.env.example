# Port the server listens on (Render sets this automatically)
PORT=3001

# Public base URL for starter question photos (must match where this server is reachable).
# Optional — Render sets RENDER_EXTERNAL_URL automatically; this overrides it when set.
# Production: https://your-render-service.onrender.com
STARTER_IMAGES_BASE_URL=http://localhost:3001

# Allowed client origin(s) for CORS. Comma-separate multiple origins.
# Production example:
# CORS_ORIGIN=https://www.alkheelan.xyz,https://alkheelan.xyz,https://alkheelan-k.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Lemon Squeezy billing — https://app.lemonsqueezy.com/settings/api
# LEMONSQUEEZY_API_KEY=
# Store ID must match the store that owns your Pro product (Lemon Squeezy → Settings → Stores)
# LEMONSQUEEZY_STORE_ID=421804
# Variant ID for Kheelan Pro — Lemon Squeezy dashboard → Products → Pro → Variants
# LEMONSQUEEZY_VARIANT_PRO=1858424
# Webhook signing secret from Settings → Webhooks
# LEMONSQUEEZY_WEBHOOK_SECRET=
# Where checkout redirects after payment (must be your public site URL in production)
# CHECKOUT_REDIRECT_URL=https://www.alkheelan.xyz
# CLIENT_URL=http://localhost:5173
# PRODUCTION_SITE_URL=https://www.alkheelan.xyz

# Optional — only for npm run apply-schema (scripts/apply-schema.mjs):
# SUPABASE_DB_PASSWORD=your-database-password
# Optional if auto-detect fails (from Dashboard → Database → Connection string):
# SUPABASE_POOLER_HOST=aws-1-ap-northeast-1.pooler.supabase.com
# SUPABASE_POOLER_PORT=6543
# Optional — Google OAuth (npm run setup:google-auth):
# SUPABASE_ACCESS_TOKEN=sbp_...
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# SITE_URL=http://localhost:5173
# PRODUCTION_SITE_URL=https://www.alkheelan.xyz
